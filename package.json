{
  "name": "node_restful_webservice",
  "version": "2.0.0",
  "description": "A RESTful Node.js API with Express, MongoDB, and JWT authentication",
  "type": "module",
  "main": "app/server.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node app/server.js",
    "dev": "NODE_ENV=development node app/server.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' mocha 'test/**/*.js'",
    "lint": "eslint app test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rob-Leggett/node_restful_webservice.git"
  },
  "author": "Robert Leggett",
  "license": "MIT",
  "homepage": "https://github.com/Rob-Leggett/node_restful_webservice",
  "bugs": {
    "url": "https://github.com/Rob-Leggett/node_restful_webservice/issues"
  },
  "keywords": [
    "node",
    "express",
    "rest",
    "api",
    "mongodb",
    "mongoose",
    "jwt",
    "authentication"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1"
  }
}
